  "info": {
    "_postman_id": "813715d4-acd1-43b2-80c7-f2026324d538",
    "name": "JumpCloud API V1 Application Templates Applications API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for managing core JumpCloud directory resources including applications, application templates, commands, and command results. Authenticated via the x-api-key header obtained from the JumpCloud Admin Console (username dropdown > API Settings). Multi-tenant administrators must additionally pass an x-org-id header.\n\nContact Support:\n Name: JumpCloud",
      "type": "text/plain"
    }
